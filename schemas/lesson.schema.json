{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lesson-media-kit/lesson.schema.json",
  "title": "Lesson Media Kit lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "metadata", "segments"],
  "properties": {
    "version": {"const": 1},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "source_language", "target_language"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_language": {"type": "string", "minLength": 2, "maxLength": 35},
        "target_language": {"type": "string", "minLength": 2, "maxLength": 35}
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "transliteration": {"type": ["string", "null"], "maxLength": 2000},
          "translation": {"type": ["string", "null"], "maxLength": 2000},
          "start_ms": {"type": ["integer", "null"], "minimum": 0},
          "duration_ms": {"type": ["integer", "null"], "exclusiveMinimum": 0}
        }
      }
    }
  }
}
